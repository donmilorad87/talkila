# Production .env for https://talkila.blazingsun.space (Hostinger).
# Copy to the server as domains/blazingsun.space/public_html/talkila/.env — see docs/DEPLOYMENT.md, step 3.
# Fill in every empty value that your features need. Never commit the filled-in file.
#
APP_NAME=Talkila
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://talkila.blazingsun.space
APP_FRONTEND_URL=https://talkila.blazingsun.space
APP_BACKEND_URL=https://talkila.blazingsun.space/v1
APP_BACKEND_ADMIN_URL=https://talkila.blazingsun.space/admin

LOG_CHANNEL=daily

# Database: hPanel → Databases (MariaDB on the same server, so DB_HOST=localhost)
DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=u383076216_talkila
DB_USERNAME=u383076216_talkila
DB_PASSWORD=

# Broadcasting: Pusher Channels (dashboard.pusher.com → your app → App Keys). PUSHER_HOST/PORT/SCHEME stay EMPTY.
BROADCAST_DRIVER=pusher
PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_APP_CLUSTER=eu
PUSHER_HOST=
PUSHER_PORT=
PUSHER_SCHEME=
# (REVERB_* only matter locally; harmless here)
REVERB_APP_ID="${PUSHER_APP_ID}"
REVERB_APP_KEY="${PUSHER_APP_KEY}"
REVERB_APP_SECRET="${PUSHER_APP_SECRET}"

MIX_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
MIX_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"

# Cache, queue, sessions: no Redis on shared hosting → files + database queue (run by the hPanel cron)
CACHE_DRIVER=file
QUEUE_CONNECTION=database
SESSION_DRIVER=file
SESSION_COOKIE=talkila_session
SESSION_DOMAIN=talkila.blazingsun.space
# HTTPS only
SESSION_SECURE_COOKIE=true
SESSION_LIFETIME=120


# Mail: a mailbox created in hPanel → Emails (or another SMTP provider)
# Looking to send emails in production? Check out our Email API/SMTP product!
MAIL_MAILER=smtp
MAIL_HOST=smtp.hostinger.com
MAIL_PORT=465
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=ssl
MAIL_FROM_ADDRESS=talkila@blazingsun.space
MAIL_FROM_NAME="${APP_NAME}"

# JWT
JWT_SECRET=

# Payment Gateway
PAYMENT_GATEWAY=stripe
STRIPE_KEY=
STRIPE_SECRET=
STRIPE_WEBHOOK_SECRET=

# Social OAuth: register these redirect URLs in each provider's developer console
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=
FACEBOOK_REDIRECT=https://talkila.blazingsun.space/auth/facebook/callback
FACEBOOK_REDIRECT_URI2=https://talkila.blazingsun.space/settings/profile

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT=https://talkila.blazingsun.space/auth/google/callback
GOOGLE_CALENDAR_REDIRECT=https://talkila.blazingsun.space/auth/google/calendar
GOOGLE_RECAPTCHA_SITE_KEY=

LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_REDIRECT_URI=https://talkila.blazingsun.space/settings/profile

INSTAGRAM_CLIENT_ID=
INSTAGRAM_CLIENT_SECRET=
INSTAGRAM_REDIRECT_URI=https://talkila.blazingsun.space/settings/profile

TWITTER_REDIRECT_URI=https://talkila.blazingsun.space/settings/profile
TWITTER_CLIENT_ID=
TWITTER_CLIENT_SECRET=
TWITTER_CLIENT_ID_OAUTH2=
TWITTER_CLIENT_SECRET_OAUTH2=

# PayPal (sandbox)
PAYPAL_ENVIRONMENT=sandbox
PAYPAL_ENDPOINTS=https://api.sandbox.paypal.com
PAYPAL_ENDPOINTS_LOCAL=https://api-m.sandbox.paypal.com
PAYPAL_ENDPOINTS_LIVE=https://api-m.paypal.com
PAYPAL_CLIENT_ID=
PAYPAL_SECRET=
PAYPAL_REST_VERSION=v2

# Firebase Push Notifications
FIREBASE_ACCESS_KEY=

# Twilio (from twiliobackend)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_API_SID=
TWILIO_API_SECRET=

# iOS VoIP Push
APNS_TOPIC=
APNS_CERT_NAME=
IOS_PUSH_URL=

# WebSocket host the browser connects to: ws-<PUSHER_APP_CLUSTER>.pusher.com
SOCKET_SERVER_URL=https://ws-eu.pusher.com
SOCKET_SERVER_URL_SHORT=ws-eu.pusher.com
SOCKET_SERVER_PORT=443

# App Settings
USER_DEFAULT_IMAGE=https://talkila.blazingsun.space/assets/images/avatar.png
IOS_STORE=https://apps.apple.com/de/app/talkila/id1580285450
IOS_STORE_APP_ID=1580285450
ANDROID_STORE_APP_ID=com.romic.talkila.production
ANDROID_STORE=https://play.google.com/store/apps/details?id=com.romic.talkila.production
TOP_SERVER=true
POSTPONE_TIME=48

# Pagination
FAVORITES_SHOW_USER_ITEMS=2
FAVORITES_SHOW_TALKS_ITEMS=2
CATEGORY_SUBCATEGORY_SHOW_ITEMS=20
CATEGORY_PROFILE_PRIVATE_TALKS_SHOW_MORE=20
NOTIFICATIONS_COUNT_SHOW_MORE=20
SHOW_MORE_TALK_ITEMS=2
GROUP_PARTICIPANTS_LIMIT=30

# Twilio call durations
RINGING_TIME_FOR_CALL=30
PICKUP_TIME_FOR_CALL_UNDER_15=120
PICKUP_TIME_FOR_CALL_OVER_15=300
