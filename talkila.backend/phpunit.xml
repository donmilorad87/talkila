<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
         cacheDirectory=".phpunit.cache">
    <testsuites>
        <!-- CI runs Api and Web (see .github/workflows/ci-cd.yml). -->
        <testsuite name="Api">
            <directory>./tests/Feature/Api</directory>
        </testsuite>
        <testsuite name="Web">
            <directory>./tests/Feature/Web</directory>
            <directory>./tests/Feature/Architecture</directory>
        </testsuite>
        <testsuite name="Unit">
            <directory>./tests/Unit</directory>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory>./app</directory>
        </include>
    </source>
    <php>
        <!-- The Docker container sets DB_*, CACHE/SESSION/QUEUE drivers as real environment variables (dev values),
             and Laravel reads $_SERVER first: every test value is forced in both $_SERVER and $_ENV.
             tests/TestCase.php also refuses to run against any database not named *_test. -->
        <server name="APP_ENV" value="testing" force="true"/>
        <env name="APP_ENV" value="testing" force="true"/>
        <server name="APP_URL" value="http://localhost" force="true"/>
        <env name="APP_URL" value="http://localhost" force="true"/>
        <server name="BCRYPT_ROUNDS" value="4" force="true"/>
        <env name="BCRYPT_ROUNDS" value="4" force="true"/>
        <server name="CACHE_DRIVER" value="array" force="true"/>
        <env name="CACHE_DRIVER" value="array" force="true"/>
        <server name="SESSION_DRIVER" value="array" force="true"/>
        <env name="SESSION_DRIVER" value="array" force="true"/>
        <server name="QUEUE_CONNECTION" value="sync" force="true"/>
        <env name="QUEUE_CONNECTION" value="sync" force="true"/>
        <server name="MAIL_MAILER" value="array" force="true"/>
        <env name="MAIL_MAILER" value="array" force="true"/>
        <server name="BROADCAST_DRIVER" value="null" force="true"/>
        <env name="BROADCAST_DRIVER" value="null" force="true"/>
        <server name="DB_CONNECTION" value="mysql" force="true"/>
        <env name="DB_CONNECTION" value="mysql" force="true"/>
        <server name="DB_DATABASE" value="talkila_test" force="true"/>
        <env name="DB_DATABASE" value="talkila_test" force="true"/>
    </php>
</phpunit>
