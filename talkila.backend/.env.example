APP_NAME=Talkila
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=https://talkila.local
APP_FRONTEND_URL=https://talkila.local
APP_BACKEND_URL=https://talkila.local/v1
APP_BACKEND_ADMIN_URL=https://talkila.local/admin

LOG_CHANNEL=daily

# MariaDB (Docker)
DB_CONNECTION=mysql
DB_HOST=mariadb
DB_PORT=3306
DB_DATABASE=talkila
DB_USERNAME=
DB_PASSWORD=

# Broadcasting: Pusher Channels (cluster eu). PUSHER_HOST/PORT/SCHEME empty = Pusher's own servers over TLS.
BROADCAST_DRIVER=pusher
PUSHER_APP_ID=2215539
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_APP_CLUSTER=eu
PUSHER_HOST=
PUSHER_PORT=
PUSHER_SCHEME=
# Laravel Reverb (local WebSocket server) uses the same app credentials as the Pusher client
REVERB_APP_ID="${PUSHER_APP_ID}"
REVERB_APP_KEY="${PUSHER_APP_KEY}"
REVERB_APP_SECRET="${PUSHER_APP_SECRET}"

MIX_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
MIX_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"

# Cache, Queue, Session (Redis)
CACHE_DRIVER=redis
QUEUE_CONNECTION=redis
SESSION_DRIVER=redis
SESSION_COOKIE=talkila_session
SESSION_DOMAIN=talkila.local
#local only SESSION_SECURE_COOKIE, on prod should be true
SESSION_SECURE_COOKIE=false
SESSION_LIFETIME=120

REDIS_HOST=redis
REDIS_PASSWORD=
REDIS_PORT=6379

# Mail (Mailtrap for local dev)
# Looking to send emails in production? Check out our Email API/SMTP product!
MAIL_MAILER=smtp
MAIL_HOST=sandbox.smtp.mailtrap.io
MAIL_PORT=2525
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS=no-reply@talkila.local
MAIL_FROM_NAME="${APP_NAME}"

# JWT
JWT_SECRET=

# Payment Gateway
PAYMENT_GATEWAY=stripe
STRIPE_KEY=
STRIPE_SECRET=
STRIPE_WEBHOOK_SECRET=

# Social OAuth (update redirect URLs for talkila.local)
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=
FACEBOOK_REDIRECT=https://talkila.local/auth/facebook/callback
FACEBOOK_REDIRECT_URI2=https://talkila.local/settings/profile

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT=https://talkila.local/auth/google/callback
GOOGLE_CALENDAR_REDIRECT=https://talkila.local/auth/google/calendar
GOOGLE_RECAPTCHA_SITE_KEY=

LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_REDIRECT_URI=https://talkila.local/settings/profile

INSTAGRAM_CLIENT_ID=
INSTAGRAM_CLIENT_SECRET=
INSTAGRAM_REDIRECT_URI=https://talkila.local/settings/profile

TWITTER_REDIRECT_URI=https://talkila.local/settings/profile
TWITTER_CLIENT_ID=
TWITTER_CLIENT_SECRET=
TWITTER_CLIENT_ID_OAUTH2=
TWITTER_CLIENT_SECRET_OAUTH2=

# PayPal (sandbox)
PAYPAL_ENVIRONMENT=sandbox
PAYPAL_ENDPOINTS=https://api.sandbox.paypal.com
PAYPAL_ENDPOINTS_LOCAL=https://api-m.sandbox.paypal.com
PAYPAL_ENDPOINTS_LIVE=https://api-m.paypal.com
PAYPAL_CLIENT_ID=
PAYPAL_SECRET=
PAYPAL_REST_VERSION=v2

# Firebase Push Notifications
FIREBASE_ACCESS_KEY=

# Twilio (from twiliobackend)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_API_SID=
TWILIO_API_SECRET=

# iOS VoIP Push
APNS_TOPIC=
APNS_CERT_NAME=
IOS_PUSH_URL=

# SOCKET_SERVER_URL: this site (call endpoints /api/user-rooms, /api/socket-event, …).
# SOCKET_SERVER_URL_SHORT: the WebSocket host browsers connect to (Pusher, cluster eu).
SOCKET_SERVER_URL=https://talkila.local
SOCKET_SERVER_URL_SHORT=ws-eu.pusher.com
SOCKET_SERVER_PORT=443

# App Settings
USER_DEFAULT_IMAGE=https://talkila.local/assets/images/avatar.png
IOS_STORE=https://apps.apple.com/de/app/talkila/id1580285450
IOS_STORE_APP_ID=1580285450
ANDROID_STORE_APP_ID=com.romic.talkila.production
ANDROID_STORE=https://play.google.com/store/apps/details?id=com.romic.talkila.production
TOP_SERVER=true
POSTPONE_TIME=48

# Pagination
FAVORITES_SHOW_USER_ITEMS=2
FAVORITES_SHOW_TALKS_ITEMS=2
CATEGORY_SUBCATEGORY_SHOW_ITEMS=20
CATEGORY_PROFILE_PRIVATE_TALKS_SHOW_MORE=20
NOTIFICATIONS_COUNT_SHOW_MORE=20
SHOW_MORE_TALK_ITEMS=2
GROUP_PARTICIPANTS_LIMIT=30

# Twilio call durations
RINGING_TIME_FOR_CALL=30
PICKUP_TIME_FOR_CALL_UNDER_15=120
PICKUP_TIME_FOR_CALL_OVER_15=300
